# Скопируйте в .env и заполните. Файл .env не коммитьте и никому не показывайте.

# --- Telegram ---
# Токен бота от @BotFather. Без него запустится только API (бот и вход из Telegram не заработают).
BOT_TOKEN=
# Публичный HTTPS-адрес, где открывается Mini App (например, адрес туннеля cloudflared/ngrok или вашего домена).
WEBAPP_URL=

# --- Доступ к админ-панели (Telegram ID через запятую; свой ID можно узнать у @userinfobot) ---
OWNER_IDS=
DEVELOPER_IDS=

# --- Режимы ---
# mock — ТЕСТОВЫЕ заглушки генерации (не настоящий AI). live — реальные API (сначала их нужно подключить в app/ai/external.py).
AI_MODE=mock
# test — тестовая оплата без денег. stars — Telegram Stars (нужен BOT_TOKEN).
# off — оплата отключена: показывается окно «Функция оплаты в разработке».
PAYMENTS_MODE=test

# --- Ключи AI-провайдеров (нужны только при AI_MODE=live) ---
IMAGE_API_KEY=
VIDEO_API_KEY=
SEEDANCE_API_KEY=
AUDIO_API_KEY=

# --- Демо-режим платформы ---
# Пауза между этапами демо-генерации, секунд (чтобы были видны «В очереди → Создаётся → Обрабатывается → Почти готово»).
DEMO_DELAY=1.0
# Приветственный бонус токенов для новых пользователей (применяется один раз при первом запуске новой версии; потом меняется в админке).
WELCOME_BONUS=100

# --- Необязательное ---
HOST=0.0.0.0
PORT=8000
DATA_DIR=data
# DATABASE_PATH=data/studio.db
# Приблизительная выручка в USD за 1 Star — используется только для оценки прибыли в админке.
STAR_USD_RATE=0.013
MAX_UPLOAD_MB=10
# Максимальный размер видео-примеров, которые владелец загружает в админке (витрина, обложки, превью).
MAX_VIDEO_MB=50
MAX_PARALLEL_GENERATIONS=3
GENERATION_TIMEOUT=600
INIT_DATA_MAX_AGE=86400
# Вход без Telegram по заголовку X-Dev-User. ТОЛЬКО для локальной отладки, на сервере держите 0.
DEV_MODE=0
